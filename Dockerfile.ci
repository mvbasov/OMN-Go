# CI only (android-gomobile-release.yml). Both stages build as one BuildKit
# graph because the docker-container driver has its own image store: a
# second build cannot resolve `FROM omn-go-base:latest` and tries to pull
# it. Keep in sync with Dockerfile.base and Dockerfile.

FROM golang:1.26-bookworm AS base_env

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    openjdk-17-jdk wget unzip cmake ninja-build

RUN --mount=type=cache,target=/tmp/dl,sharing=locked \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-10406996_latest.zip -O /tmp/dl/cmd.zip && \
    mkdir -p /opt/android/cmdline-tools && \
    unzip -q /tmp/dl/cmd.zip -d /opt/android/cmdline-tools && \
    mv /opt/android/cmdline-tools/cmdline-tools /opt/android/cmdline-tools/latest

ENV ANDROID_HOME=/opt/android
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools

RUN --mount=type=cache,target=/opt/android/.android/cache,sharing=locked \
    yes | sdkmanager --licenses && \
    sdkmanager "platforms;android-34" "build-tools;33.0.1" "platform-tools" "ndk;25.2.9519653"

RUN --mount=type=cache,target=/tmp/dl,sharing=locked \
    wget -q https://services.gradle.org/distributions/gradle-8.5-bin.zip -O /tmp/dl/gradle.zip && \
    mkdir -p /opt/gradle && \
    unzip -q /tmp/dl/gradle.zip -d /opt/gradle
ENV PATH=$PATH:/opt/gradle/gradle-8.5/bin

WORKDIR /app

# The host has no Go toolchain, so go.sum and the x/mobile tool dependency
# are resolved here. /root/lockfiles is a path the `COPY . .` in stage 2
# never touches, so the result survives it and gets restored afterward.
COPY go.mod ./
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go get -tool golang.org/x/mobile/cmd/gobind golang.org/x/mobile/cmd/gomobile && \
    go mod download && \
    go install golang.org/x/mobile/cmd/gobind && \
    go install golang.org/x/mobile/cmd/gomobile && \
    gomobile init && \
    mkdir -p /root/lockfiles && cp go.mod go.sum /root/lockfiles/

FROM base_env AS project_builder

ARG SKIP_TESTS=0

COPY . .

# Restore stage 1's resolved go.mod and go.sum over the host's copies.
RUN cp /root/lockfiles/go.mod /root/lockfiles/go.sum ./

# Safety net, not a resolution step. A no-op that touches no network while
# go.mod matches what the source imports.
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod tidy

# Vet and the unit tests must pass before any artifact is built.
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    if [ "$SKIP_TESTS" = "1" ]; then \
        echo "WARNING: SKIP_TESTS=1 - test gate bypassed"; \
    else \
        go vet ./backend/... && \
        go test ./backend/...; \
    fi

RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    VERSION=$(awk -F'"' '/APP_VERSION =/ {print $2}' backend/version.go) && \
    export GOFLAGS="-ldflags=-s -w -trimpath" && \
    GOOS=linux GOARCH=amd64 go build -o "bin/omn-go-v${VERSION}-desktop-linux-amd64" main_desktop.go && \
    CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -o "bin/omn-go-v${VERSION}-desktop-windows-amd64.exe" main_desktop.go

# The Android application carries strictly zero AndroidX or AppCompat.
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    mkdir -p android/app/libs && \
    gomobile bind -target=android -androidapi 24 -javapkg net.basov.omngo -ldflags="-s -w" -o android/app/libs/omngo.aar ./backend

# Standard flavor only. F-Droid builds and re-signs its own variant from
# metadata/net.basov.omngo.fdroid.yml, so an APK built here would look
# official without being what F-Droid distributes.
#
# Secrets are mounted, not ARGs, so no keystore and no password reaches an
# image layer. The four secret ids are the contract every CI system must
# satisfy. required=true fails the step at once when a job omits one.
RUN --mount=type=cache,target=/root/.gradle,sharing=locked \
    --mount=type=secret,id=keystore,required=true \
    --mount=type=secret,id=keystore_password,required=true \
    --mount=type=secret,id=key_alias,required=true \
    --mount=type=secret,id=key_password,required=true \
    export KEYSTORE_FILE="/run/secrets/keystore" && \
    export KEYSTORE_PASSWORD="$(cat /run/secrets/keystore_password)" && \
    export KEY_ALIAS="$(cat /run/secrets/key_alias)" && \
    export KEY_PASSWORD="$(cat /run/secrets/key_password)" && \
    cd android && \
    gradle assembleStandardRelease && \
    cp app/build/outputs/apk/standard/release/*.apk ../bin/

# Build with `--target export --output type=local,dest=artifacts`. Loading
# the multi-GB toolchain image into the Docker daemon fills the disk on a
# small runner. This is the last stage, so a plain `docker build` with no
# --target produces the artifacts-only image.
FROM scratch AS export
COPY --from=project_builder /app/bin/ /
